# Prefer npm run setup to generate a strong database password.
PUBLIC_ORIGIN=http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
ALLOW_INSECURE_LOCAL=1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=atj
DB_USER=atj
DB_PASSWORD_FILE=.secrets/db_password
DB_OWNER_PASSWORD_FILE=.secrets/db_owner_password
ENQUIRY_RETENTION_DAYS=365
