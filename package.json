{
  "name": "all-that-jazz-studio",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "build": "node scripts/build.mjs",
    "setup": "node scripts/setup.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "maintenance": "node --env-file-if-exists=.env scripts/maintenance.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1"
  }
}
